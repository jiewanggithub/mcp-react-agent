# ==== LLM Provider: 通义千问 (Qwen) ====
# 是否使用真实的通义千问 API。设为 false 时使用内置 Mock LLM（无需 Key 即可跑通整条链路）。
USE_REAL_LLM=false

# 通义千问 DashScope 的 OpenAI 兼容接口
# 参考: https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ==== 高德地图 MCP Server (SSE) ====
# 前往 https://lbs.amap.com/api/mcp-server 申请 Key
AMAP_MCP_SSE_URL=https://mcp.amap.com/sse?key=YOUR_AMAP_KEY

# ==== 服务配置 ====
APP_HOST=0.0.0.0
APP_PORT=8000
# 允许跨域访问的前端地址
CORS_ORIGINS=http://localhost:5173

# 文件写入工具的输出目录（相对于 backend/）
FILE_OUTPUT_DIR=data/output
